  "principles": [
    {
      "id": "visibility",
      "rule": "Choose lighting systems for the subject and available angles before effects.",
      "sources": [
        "etc-angles"
      ],
      "evidence": "documented-principle"
    },
    {
      "id": "color-separation",
      "rule": "Use key-light and decorative color as separate design layers.",
      "sources": [
        "etc-angles"
      ],
      "evidence": "application-recommendation"
    },
    {
      "id": "effect-base",
      "rule": "Movement requires deliberate base positions and fixture offsets.",
      "sources": [
        "magicq-fx"
      ],
      "evidence": "documented-principle"
    },
    {
      "id": "capability",
      "rule": "Generate only attributes supported by the actual fixture definitions.",
      "sources": [],
      "evidence": "engineering-requirement"
    },
    {
      "id": "intent",
      "rule": "Explicit exclusions override proposed effects; missing information becomes an assumption or question.",
      "sources": [],
      "evidence": "product-requirement"
    }
  ],
